[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Terrain/Generation/VoxelBakeConstants.h>

/// Per-voxel packed data input (M³ uint32s). Lower 16 = SDF float16, upper 16 = strength float16. Read-only here.
StructuredBuffer<uint>   BakedVoxelDistIn  BIND_GROUP(BG_DRAW_CALL);
/// Cleaned output — fed to VoxelBlurDistCS.
RWStructuredBuffer<uint> BakedVoxelDistOut BIND_GROUP(BG_DRAW_CALL);
/// Packed voxel nibbles, mutated in place: culled voxels get dist set to air; nibbles are preserved.
RWStructuredBuffer<uint>  BakedVoxels       BIND_GROUP(BG_DRAW_CALL);

bool IsSolid(int3 p, int M)
{
  if (p.x < 0 || p.y < 0 || p.z < 0) return false;
  if (p.x >= M || p.y >= M || p.z >= M) return false;
  return f16tof32(BakedVoxelDistIn[(uint)p.z * M * M + (uint)p.y * M + (uint)p.x] & 0xFFFFu) <= 0.0f;
}

[numthreads(4, 4, 4)]
void main(uint3 DTid : SV_DispatchThreadID)
{
  const int M = (int)GET_PUSH_CONSTANT(VoxelBakeConstants, VoxelResolution);
  const int MP = M / 8;
  const float airDist = GET_PUSH_CONSTANT(VoxelBakeConstants, GridSpacing);

  if ((int)DTid.x >= MP || (int)DTid.y >= M || (int)DTid.z >= M)
    return;

  uint packedIn  = BakedVoxels[DTid.z * M * MP + DTid.y * MP + DTid.x];
  uint packedOut = 0u;

  // Air-distance value written for culled voxels. One voxel of slack so the subsequent
  // blur cannot pull the neighborhood back through zero on its own.

  [unroll]
  for (int i = 0; i < 8; ++i)
  {
    int3 p = int3((int)DTid.x * 8 + i, (int)DTid.y, (int)DTid.z);
    uint origNibble = (packedIn >> (i * 4)) & 0xFu;
    uint packedVoxel = BakedVoxelDistIn[p.z * M * M + p.y * M + p.x];
    float distOrig  = f16tof32(packedVoxel & 0xFFFFu);

    if (distOrig > 0.0f)
    {
      packedOut |= (origNibble & 0xFu) << (i * 4); // already air, pass through
      BakedVoxelDistOut[p.z * M * M + p.y * M + p.x] = packedVoxel;
      continue;
    }

    int faceCount = 0;
    int edgeCount = 0;

    [unroll] for (int a = 0; a < 6; ++a)
    {
      int3 o = int3(0, 0, 0);
      if (a == 0) o = int3( 1, 0, 0);
      if (a == 1) o = int3(-1, 0, 0);
      if (a == 2) o = int3( 0, 1, 0);
      if (a == 3) o = int3( 0,-1, 0);
      if (a == 4) o = int3( 0, 0, 1);
      if (a == 5) o = int3( 0, 0,-1);
      if (IsSolid(p + o, M)) faceCount++;
    }

    [unroll] for (int b = 0; b < 12; ++b)
    {
      int3 o = int3(0, 0, 0);
      if (b ==  0) o = int3( 1, 1, 0);
      if (b ==  1) o = int3( 1,-1, 0);
      if (b ==  2) o = int3(-1, 1, 0);
      if (b ==  3) o = int3(-1,-1, 0);
      if (b ==  4) o = int3( 1, 0, 1);
      if (b ==  5) o = int3( 1, 0,-1);
      if (b ==  6) o = int3(-1, 0, 1);
      if (b ==  7) o = int3(-1, 0,-1);
      if (b ==  8) o = int3( 0, 1, 1);
      if (b ==  9) o = int3( 0, 1,-1);
      if (b == 10) o = int3( 0,-1, 1);
      if (b == 11) o = int3( 0,-1,-1);
      if (IsSolid(p + o, M)) edgeCount++;
    }

    bool keep = (faceCount >= 1 && edgeCount >= 1) || (faceCount >= 2);

    uint newNibble;
    uint packedOut_voxel;
    if (keep)
    {
      newNibble      = origNibble;
      packedOut_voxel = packedVoxel; // preserve SDF and strength
    }
    else
    {
      newNibble      = origNibble; // keep material; solid/air is determined by dist sign
      packedOut_voxel = f32tof16(airDist); // mark as air; strength stays 0 for culled voxels
    }

    packedOut |= (newNibble & 0xFu) << (i * 4);
    BakedVoxelDistOut[p.z * M * M + p.y * M + p.x] = packedOut_voxel;
  }

  BakedVoxels[DTid.z * M * MP + DTid.y * MP + DTid.x] = packedOut;
}
