[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Terrain/Generation/HeightfieldBakeConstants.h>

/// Baked heights produced by TerrainBakeCS, read as SRV.
/// Bound as SRV (not UAV) so the engine inserts a UAV→SRV barrier between Step 1's writes and our reads here.
StructuredBuffer<float> BakedHeights BIND_GROUP(BG_DRAW_CALL);

/// Output: per-vertex XY normal components packed as two 16-bit floats into a uint32.
/// The Z component is reconstructed as sqrt(1 - x*x - y*y) in the vertex shader.
RWStructuredBuffer<uint> BakedNormals BIND_GROUP(BG_DRAW_CALL);

float SampleHeight(int2 pos, int vertexIdxPitch)
{
  int2 clamped = clamp(pos, int2(0, 0), int2(vertexIdxPitch - 1, vertexIdxPitch - 1));
  return BakedHeights[clamped.y * vertexIdxPitch + clamped.x];
}

[numthreads(16, 16, 1)]
void main(uint3 DTid : SV_DispatchThreadID)
{
  const uint vertexIdxPitch = GET_PUSH_CONSTANT(HeightfieldBakeConstants, VertexIdxPitch);
  const float gridSpacing = GET_PUSH_CONSTANT(HeightfieldBakeConstants, GridSpacing);

  if (DTid.x >= vertexIdxPitch || DTid.y >= vertexIdxPitch)
    return;

  int2 coord = int2(DTid.xy);

  float hL = SampleHeight(coord + int2(-1,  0), (int)vertexIdxPitch);
  float hR = SampleHeight(coord + int2( 1,  0), (int)vertexIdxPitch);
  float hD = SampleHeight(coord + int2( 0, -1), (int)vertexIdxPitch);
  float hU = SampleHeight(coord + int2( 0,  1), (int)vertexIdxPitch);

  // Central-difference slope over two grid cells gives the unnormalized normal (-dH/dX, -dH/dY, 1).
  float dx = (hR - hL) / (2.0 * gridSpacing);
  float dy = (hU - hD) / (2.0 * gridSpacing);
  float3 n = normalize(float3(-dx, -dy, 1.0));

  // Pack XY as 16-bit floats in a single uint; Z is always positive and reconstructed later.
  uint packed = f32tof16(n.x) | (f32tof16(n.y) << 16);
  BakedNormals[DTid.y * vertexIdxPitch + DTid.x] = packed;
}
