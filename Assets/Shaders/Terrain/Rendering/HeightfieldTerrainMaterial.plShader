[PIXELSHADER]

#define USE_MATERIAL_OCCLUSION

#define CUSTOM_GLOBALS \
  float3 TpWeights; \
  float3 Scales;    \
  uint2  TexIndices1; \
  uint2  TexIndices2; \
  uint2  TexIndices3; \
  float3 LayerSamplePosition; \
  float3 MatWeights;

#include <Shaders/Materials/MaterialPixelShader.h>
#include <Shaders/Terrain/Rendering/HeightfieldRenderConstants.h>
#include <Shaders/Terrain/Rendering/TerrainLayerSampling.h>

Texture2DArray LayerBaseTexture BIND_GROUP(BG_MATERIAL);
SamplerState LayerBaseTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2DArray LayerNormalTexture BIND_GROUP(BG_MATERIAL);
SamplerState LayerNormalTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2DArray LayerORMTexture BIND_GROUP(BG_MATERIAL);
SamplerState LayerORMTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2DArray LayerDisplacementTexture BIND_GROUP(BG_MATERIAL);
SamplerState LayerDisplacementTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

static const min16uint NUM_TERRAIN_PARALLAX_STEPS = 24;
static const float NUM_TERRAIN_PARALLAX_STEPS_RCP = 1.0 / NUM_TERRAIN_PARALLAX_STEPS;

/// Baked material mask (already normalized and slot-sorted in HeightfieldTerrainBakeStep1CS).
/// Read directly in PS to avoid VS→PS interpolation artifacts where material index
/// assignments differ per vertex.
StructuredBuffer<uint2> TerrainMask BIND_GROUP(BG_DRAW_CALL);

static const uint NUM_TERRAIN_LAYERS = 32;

/// The four vertices around a pixel carry at most 12 distinct layers. Their weights are summed per layer id here.
static const uint MAX_MASK_CANDIDATES = 12;

void AddMaskCandidate(uint matIdx, float weight, inout uint ids[MAX_MASK_CANDIDATES], inout float weights[MAX_MASK_CANDIDATES], inout uint count)
{
  if (weight <= 0.0)
    return;

  // Ids past the material's layer table use its last entry instead of dropping their weight.
  matIdx = min(matIdx, NUM_TERRAIN_LAYERS - 1u);

  [unroll] for (uint i = 0u; i < MAX_MASK_CANDIDATES; ++i)
  {
    if (i < count && ids[i] == matIdx)
    {
      weights[i] += weight;
      return;
    }
  }

  ids[count] = matIdx;
  weights[count] = weight;
  ++count;
}

void AccumulateMaskWeights(uint2 packed, float sampleWeight, inout uint ids[MAX_MASK_CANDIDATES], inout float weights[MAX_MASK_CANDIDATES], inout uint count)
{
  uint matIdx0 =  packed.x        & 0xFFu;
  uint matIdx1 = (packed.x >>  8) & 0xFFu;
  uint matIdx2 = (packed.x >> 16) & 0xFFu;

  float w0 = (float)((packed.x >> 24) & 0xFFu) * (1.0 / 255.0);
  float w1 = (float)( packed.y        & 0xFFu) * (1.0 / 255.0);
  float w2 = (float)((packed.y >>  8) & 0xFFu) * (1.0 / 255.0);

  AddMaskCandidate(matIdx0, w0 * sampleWeight, ids, weights, count);
  AddMaskCandidate(matIdx1, w1 * sampleWeight, ids, weights, count);
  AddMaskCandidate(matIdx2, w2 * sampleWeight, ids, weights, count);
}

void GetLayerData(uint matIdx, out int2 ref_texIndices, out float ref_fScale)
{
  ref_texIndices = GetMaterialData(Material0TextureIndex);
  ref_fScale = GetMaterialData(Material0Scale);

  [forcecase] switch (matIdx)
  {
    case 1u: ref_texIndices = GetMaterialData(Material1TextureIndex); ref_fScale = GetMaterialData(Material1Scale); break;
    case 2u: ref_texIndices = GetMaterialData(Material2TextureIndex); ref_fScale = GetMaterialData(Material2Scale); break;
    case 3u: ref_texIndices = GetMaterialData(Material3TextureIndex); ref_fScale = GetMaterialData(Material3Scale); break;
    case 4u: ref_texIndices = GetMaterialData(Material4TextureIndex); ref_fScale = GetMaterialData(Material4Scale); break;
    case 5u: ref_texIndices = GetMaterialData(Material5TextureIndex); ref_fScale = GetMaterialData(Material5Scale); break;
    case 6u: ref_texIndices = GetMaterialData(Material6TextureIndex); ref_fScale = GetMaterialData(Material6Scale); break;
    case 7u: ref_texIndices = GetMaterialData(Material7TextureIndex); ref_fScale = GetMaterialData(Material7Scale); break;
    case 8u: ref_texIndices = GetMaterialData(Material8TextureIndex); ref_fScale = GetMaterialData(Material8Scale); break;
    case 9u: ref_texIndices = GetMaterialData(Material9TextureIndex); ref_fScale = GetMaterialData(Material9Scale); break;
    case 10u: ref_texIndices = GetMaterialData(Material10TextureIndex); ref_fScale = GetMaterialData(Material10Scale); break;
    case 11u: ref_texIndices = GetMaterialData(Material11TextureIndex); ref_fScale = GetMaterialData(Material11Scale); break;
    case 12u: ref_texIndices = GetMaterialData(Material12TextureIndex); ref_fScale = GetMaterialData(Material12Scale); break;
    case 13u: ref_texIndices = GetMaterialData(Material13TextureIndex); ref_fScale = GetMaterialData(Material13Scale); break;
    case 14u: ref_texIndices = GetMaterialData(Material14TextureIndex); ref_fScale = GetMaterialData(Material14Scale); break;
    case 15u: ref_texIndices = GetMaterialData(Material15TextureIndex); ref_fScale = GetMaterialData(Material15Scale); break;
    case 16u: ref_texIndices = GetMaterialData(Material16TextureIndex); ref_fScale = GetMaterialData(Material16Scale); break;
    case 17u: ref_texIndices = GetMaterialData(Material17TextureIndex); ref_fScale = GetMaterialData(Material17Scale); break;
    case 18u: ref_texIndices = GetMaterialData(Material18TextureIndex); ref_fScale = GetMaterialData(Material18Scale); break;
    case 19u: ref_texIndices = GetMaterialData(Material19TextureIndex); ref_fScale = GetMaterialData(Material19Scale); break;
    case 20u: ref_texIndices = GetMaterialData(Material20TextureIndex); ref_fScale = GetMaterialData(Material20Scale); break;
    case 21u: ref_texIndices = GetMaterialData(Material21TextureIndex); ref_fScale = GetMaterialData(Material21Scale); break;
    case 22u: ref_texIndices = GetMaterialData(Material22TextureIndex); ref_fScale = GetMaterialData(Material22Scale); break;
    case 23u: ref_texIndices = GetMaterialData(Material23TextureIndex); ref_fScale = GetMaterialData(Material23Scale); break;
    case 24u: ref_texIndices = GetMaterialData(Material24TextureIndex); ref_fScale = GetMaterialData(Material24Scale); break;
    case 25u: ref_texIndices = GetMaterialData(Material25TextureIndex); ref_fScale = GetMaterialData(Material25Scale); break;
    case 26u: ref_texIndices = GetMaterialData(Material26TextureIndex); ref_fScale = GetMaterialData(Material26Scale); break;
    case 27u: ref_texIndices = GetMaterialData(Material27TextureIndex); ref_fScale = GetMaterialData(Material27Scale); break;
    case 28u: ref_texIndices = GetMaterialData(Material28TextureIndex); ref_fScale = GetMaterialData(Material28Scale); break;
    case 29u: ref_texIndices = GetMaterialData(Material29TextureIndex); ref_fScale = GetMaterialData(Material29Scale); break;
    case 30u: ref_texIndices = GetMaterialData(Material30TextureIndex); ref_fScale = GetMaterialData(Material30Scale); break;
    case 31u: ref_texIndices = GetMaterialData(Material31TextureIndex); ref_fScale = GetMaterialData(Material31Scale); break;
    default: break;
  }
}

void InsertTopMaterial(uint matIdx, float weight, inout uint3 outMatIndices, inout float3 outWeights)
{
  if (weight <= 0.0)
    return;

  if (weight > outWeights.x)
  {
    outWeights.z = outWeights.y; outMatIndices.z = outMatIndices.y;
    outWeights.y = outWeights.x; outMatIndices.y = outMatIndices.x;
    outWeights.x = weight;       outMatIndices.x = matIdx;
  }
  else if (weight > outWeights.y)
  {
    outWeights.z = outWeights.y; outMatIndices.z = outMatIndices.y;
    outWeights.y = weight;       outMatIndices.y = matIdx;
  }
  else if (weight > outWeights.z)
  {
    outWeights.z = weight;       outMatIndices.z = matIdx;
  }
}

/// Bilinearly filters decoded material weights by material id. Slot-wise interpolation is invalid
/// because neighboring vertices may store the same material in different packed slots.
void SampleTerrainMask(out uint2 texIndices1, out uint2 texIndices2, out uint2 texIndices3, out float3 matWeights, out float3 scales)
{
  const uint cellsPerSide = GET_PUSH_CONSTANT(HeightfieldRenderConstants, CellsPerSide);
  const uint firstVertexIdx = GET_PUSH_CONSTANT(HeightfieldRenderConstants, FirstVertexIdx);
  const uint vertexIdxPitch = GET_PUSH_CONSTANT(HeightfieldRenderConstants, VertexIdxPitch);

  const float fCellsPerSide = float(cellsPerSide);
  const float2 gridPos = saturate(G.Input.TexCoord0.xy) * fCellsPerSide;
  const uint2 p0 = min((uint2)floor(gridPos), uint2(cellsPerSide, cellsPerSide));
  const uint2 p1 = min(p0 + uint2(1, 1), uint2(cellsPerSide, cellsPerSide));
  const float2 f = frac(gridPos);

  uint ids[MAX_MASK_CANDIDATES];
  float weights[MAX_MASK_CANDIDATES];
  [unroll] for (uint i = 0u; i < MAX_MASK_CANDIDATES; ++i)
  {
    ids[i] = 0u;
    weights[i] = 0.0;
  }
  uint count = 0u;

  AccumulateMaskWeights(TerrainMask[firstVertexIdx + p0.y * vertexIdxPitch + p0.x], (1.0 - f.x) * (1.0 - f.y), ids, weights, count);
  AccumulateMaskWeights(TerrainMask[firstVertexIdx + p0.y * vertexIdxPitch + p1.x],        f.x  * (1.0 - f.y), ids, weights, count);
  AccumulateMaskWeights(TerrainMask[firstVertexIdx + p1.y * vertexIdxPitch + p0.x], (1.0 - f.x) *        f.y,  ids, weights, count);
  AccumulateMaskWeights(TerrainMask[firstVertexIdx + p1.y * vertexIdxPitch + p1.x],        f.x  *        f.y,  ids, weights, count);

  uint3 matIndices = uint3(0, 0, 0);
  matWeights = float3(0.0, 0.0, 0.0);

  [unroll] for (uint c = 0u; c < MAX_MASK_CANDIDATES; ++c)
  {
    if (c < count)
      InsertTopMaterial(ids[c], weights[c], matIndices, matWeights);
  }

  const float totalW = matWeights.x + matWeights.y + matWeights.z;
  if (totalW > 0.001)
    matWeights /= totalW;
  else
    matWeights = float3(1.0, 0.0, 0.0);

  const float textureScale = GetMaterialData(TextureScale);
  int2 layerTexIndices;
  float layerScale;

  GetLayerData(matIndices.x, layerTexIndices, layerScale);
  texIndices1 = layerTexIndices;
  scales.x = textureScale * layerScale;

  GetLayerData(matIndices.y, layerTexIndices, layerScale);
  texIndices2 = layerTexIndices;
  scales.y = textureScale * layerScale;

  GetLayerData(matIndices.z, layerTexIndices, layerScale);
  texIndices3 = layerTexIndices;
  scales.z = textureScale * layerScale;
}

float SampleTerrainDisplacement(float3 worldPos)
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float h0 = TriplanarSampleColorArray(LayerDisplacementTexture, LayerDisplacementTexture_AutoSampler, worldPos, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic).r;
  const float h1 = TriplanarSampleColorArray(LayerDisplacementTexture, LayerDisplacementTexture_AutoSampler, worldPos, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic).r;
  const float h2 = TriplanarSampleColorArray(LayerDisplacementTexture, LayerDisplacementTexture_AutoSampler, worldPos, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic).r;

  return h0 * G.MatWeights.x + h1 * G.MatWeights.y + h2 * G.MatWeights.z;
}

float3 ComputeTerrainParallaxWorldPosition(float3 worldPos)
{
  float scale = GetMaterialData(HeightScale) * 0.01;
  if (scale <= 0.0)
    return worldPos;

  float3 viewDirection = normalize(GetCameraPosition() - worldPos);
  float ndotv = max(dot(G.Input.Normal, viewDirection), 0.15);
  float3 tangentViewDirection = viewDirection - G.Input.Normal * dot(G.Input.Normal, viewDirection);

  float tangentLengthSq = dot(tangentViewDirection, tangentViewDirection);
  if (tangentLengthSq <= 0.0001)
    return worldPos;

  float3 parallaxDirection = -tangentViewDirection * rsqrt(tangentLengthSq);
  float3 stepOffset = parallaxDirection * (scale / ndotv) * NUM_TERRAIN_PARALLAX_STEPS_RCP;

  float3 currentWorldPos = worldPos;
  float currentLayerHeight = 0.0;
  float heightFromTexture = 1.0 - SampleTerrainDisplacement(currentWorldPos);

  [loop]
  for (min16uint iter = 0; iter < NUM_TERRAIN_PARALLAX_STEPS && heightFromTexture > currentLayerHeight; ++iter)
  {
    currentLayerHeight += NUM_TERRAIN_PARALLAX_STEPS_RCP;
    currentWorldPos += stepOffset;
    heightFromTexture = 1.0 - SampleTerrainDisplacement(currentWorldPos);
  }

  return currentWorldPos;
}

void FillCustomGlobals()
{
  G.TpWeights = TriplanarWeights(G.Input.Normal);
  SampleTerrainMask(G.TexIndices1, G.TexIndices2, G.TexIndices3, G.MatWeights, G.Scales);

  G.LayerSamplePosition = G.Input.WorldPosition;
  if (GetMaterialData(UseDisplacementTexture))
  {
    G.LayerSamplePosition = ComputeTerrainParallaxWorldPosition(G.LayerSamplePosition);
  }
}

float3 GetNormal()
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float3 n0 = TriplanarSampleNormalArray(LayerNormalTexture, LayerNormalTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic);
  const float3 n1 = TriplanarSampleNormalArray(LayerNormalTexture, LayerNormalTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic);
  const float3 n2 = TriplanarSampleNormalArray(LayerNormalTexture, LayerNormalTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic);

  return normalize(n0 * G.MatWeights.x + n1 * G.MatWeights.y + n2 * G.MatWeights.z);
}

float3 GetBaseColor()
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float3 c0 = TriplanarSampleColorArray(LayerBaseTexture, LayerBaseTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic).rgb;
  const float3 c1 = TriplanarSampleColorArray(LayerBaseTexture, LayerBaseTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic).rgb;
  const float3 c2 = TriplanarSampleColorArray(LayerBaseTexture, LayerBaseTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic).rgb;

  return c0 * G.MatWeights.x + c1 * G.MatWeights.y + c2 * G.MatWeights.z;
}

float GetRoughness()
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float r0 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic).g;
  const float r1 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic).g;
  const float r2 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic).g;

  return (r0 * G.MatWeights.x + r1 * G.MatWeights.y + r2 * G.MatWeights.z) + GetMaterialData(RoughnessBias);
}

float GetMetallic()
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float m0 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic).b;
  const float m1 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic).b;
  const float m2 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic).b;

  return (m0 * G.MatWeights.x + m1 * G.MatWeights.y + m2 * G.MatWeights.z);
}

float GetOcclusion()
{
  const bool useStochastic = GetMaterialData(UseStochasticSampling);
  const float o0 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.x, G.TexIndices1, useStochastic).r;
  const float o1 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.y, G.TexIndices2, useStochastic).r;
  const float o2 = TriplanarSampleColorArray(LayerORMTexture, LayerORMTexture_AutoSampler, G.LayerSamplePosition, G.Input.Normal, G.TpWeights, G.Scales.z, G.TexIndices3, useStochastic).r;

  float occlusion = o0 * G.MatWeights.x + o1 * G.MatWeights.y + o2 * G.MatWeights.z;
  if (GetMaterialData(InvertOcclusion))
  {
    occlusion = 1.0 - occlusion;
  }

  return 1.0;
}

float GetReflectance() { return 0.5f; }
float GetOpacity()     { return 1.0f; }
